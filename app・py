import os
import time
import hmac
import hashlib
import base64
import requests

from flask import Flask, request, abort

app = Flask(__name__)

CHANNEL_SECRET = os.environ.get("CHANNEL_SECRET", "")
CHANNEL_ACCESS_TOKEN = os.environ.get("CHANNEL_ACCESS_TOKEN", "")

# ユーザーごとの連投記録
user_messages = {}

# 連投判定
MAX_SAME_MESSAGE = 3
TIME_WINDOW = 10


def verify_signature(body, signature):
    hash_value = hmac.new(
        CHANNEL_SECRET.encode("utf-8"),
        body,
        hashlib.sha256
    ).digest()

    expected_signature = base64.b64encode(hash_value).decode("utf-8")

    return hmac.compare_digest(expected_signature, signature)


def reply_message(reply_token, text):
    url = "https://api.line.me/v2/bot/message/reply"

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {CHANNEL_ACCESS_TOKEN}"
    }

    data = {
        "replyToken": reply_token,
        "messages": [
            {
                "type": "text",
                "text": text
            }
        ]
    }

    requests.post(url, headers=headers, json=data, timeout=10)


@app.route("/", methods=["GET"])
def home():
    return "LINE Protection Bot is running!"


@app.route("/callback", methods=["POST"])
def callback():
    body = request.get_data()
    signature = request.headers.get("X-Line-Signature", "")

    # LINEからの正しい通信か確認
    if not CHANNEL_SECRET:
        abort(500)

    if not verify_signature(body, signature):
        abort(400)

    data = request.get_json()

    for event in data.get("events", []):
        if event.get("type") != "message":
            continue

        message = event.get("message", {})

        if message.get("type") != "text":
            continue

        user_id = event.get("source", {}).get("userId", "unknown")
        text = message.get("text", "").strip()

        now = time.time()

        # 古い記録を削除
        if user_id not in user_messages:
            user_messages[user_id] = []

        user_messages[user_id] = [
            item for item in user_messages[user_id]
            if now - item["time"] <= TIME_WINDOW
        ]

        # 今回のメッセージを記録
        user_messages[user_id].append({
            "text": text,
            "time": now
        })

        # 同じ文章の連投をチェック
        same_count = sum(
            1 for item in user_messages[user_id]
            if item["text"] == text
        )

        if same_count >= MAX_SAME_MESSAGE:
            reply_token = event.get("replyToken")

            if reply_token:
                reply_message(
                    reply_token,
                    "⚠️ 連投を検知しました。\n同じメッセージの連続投稿は控えてください。"
                )

    return "OK"


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8080))
    app.run(host="0.0.0.0", port=port)
